PORT=5001
NODE_ENV=development

# Leave MONGO_URI empty in development to use a built-in local MongoDB
# (data is stored in backend/.data). Use your Atlas URI in production.
MONGO_URI=

JWT_SECRET=change_me_to_a_long_random_string

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# auto | atlas | local — "auto" uses Atlas $vectorSearch when available,
# otherwise in-app cosine similarity.
VECTOR_SEARCH=auto

# Extra comma-separated origins allowed by CORS
CLIENT_URLS=
